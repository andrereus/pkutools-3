{
  "rules": {
    "communityFoods": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["language", "contributorId", "score"]
    },
    "communityFoodComments": {
      ".read": "auth != null",
      ".write": false
    },
    "communityPosts": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": [
        "languageCreatedAt",
        "authorId",
        "hiddenAt",
        "updatedAt",
        "lastCommunityCommentAt",
        "lastAuthorCommentAt"
      ]
    },
    "communityPostComments": {
      ".read": "auth != null",
      ".write": false
    },
    "communityProfiles": {
      ".read": "auth != null",
      ".write": false
    },
    "communityNameKeys": {
      ".read": false,
      ".write": false
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "$uid": {
      ".read": "$uid === auth.uid",
      ".write": false,
      "pheDiary": {
        ".indexOn": ["date"]
      },
      "labValues": {
        ".indexOn": ["date"]
      }
    }
  }
}
