{
  "rules": {
    "communityFoods": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["language", "contributorId", "score"]
    },
    "communityFoodComments": {
      ".read": "auth != null",
      ".write": false
    },
    "communityPosts": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["createdAt", "authorId"]
    },
    "communityPostComments": {
      ".read": "auth != null",
      ".write": false
    },
    "communityProfiles": {
      ".read": "auth != null",
      ".write": false
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "removedContent": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["authorId"]
    },
    "$uid": {
      ".read": "$uid === auth.uid",
      ".write": false,
      "pheDiary": {
        ".indexOn": ["date"]
      },
      "labValues": {
        ".indexOn": ["date"]
      }
    }
  }
}
